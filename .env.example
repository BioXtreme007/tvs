# ==============================================================================
# TVS Credit AI-Powered Smart Lending Decision Hub
# Environment Configuration Template (.env.example)
# Copy to .env and configure for local or production deployments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Execution & Environment Modes
# ------------------------------------------------------------------------------
# DEMO_MODE: Set to "false" in institutional production to disable synthetic
# fallbacks, simulated remote sensing indices, and unauthenticated demo contexts.
# Set to "true" for local demo walkthroughs and automated mock testing.
DEMO_MODE=true

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Whitelist (Comma-separated origins, no trailing slashes)
# In production, specify exact institutional domain names (e.g. https://lending.tvscredit.com)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Durable Database Configuration
# ------------------------------------------------------------------------------
# Default: SQLite with Write-Ahead Logging (WAL) in data/tvs_lending.db
DATABASE_URL=data/tvs_lending.db

# For PostgreSQL in enterprise production:
# DATABASE_URL=postgresql://tvs_app:SecurePassword@localhost:5432/tvs_lending

# ------------------------------------------------------------------------------
# 3. LLM & Multimodal AI Providers (Krishi Saathi & Agentic Deliberation)
# ------------------------------------------------------------------------------
# Google Gemini (Primary multimodal provider)
# Documented model identifier: gemini-3.8-flash (or gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq Cloud (Ultra-low latency Llama-3.3-70B inference)
GROQ_API_KEY=

# Cerebras Inference Cloud
CEREBRAS_API_KEY=

# OpenAI (Optional fallback provider)
OPENAI_API_KEY=

# Local Ollama Inference (Air-gapped / on-prem edge deployments)
ENABLE_LOCAL_OLLAMA=false
OLLAMA_MODEL=qwen2.5:1.5b

# ------------------------------------------------------------------------------
# 4. Institutional Role Invite Codes
# ------------------------------------------------------------------------------
# Institutional secret code required during public signup to assign officer/manager roles.
# If omitted or mismatched, public signups are assigned least-privilege "Borrower" role.
TVS_OFFICER_INVITE_CODE=TVS_OFFICER_2026

# ------------------------------------------------------------------------------
# 5. Database Backup & Disaster Recovery Instructions
# ------------------------------------------------------------------------------
# SQLite Hot Backup (WAL Mode):
#   sqlite3 data/tvs_lending.db ".backup data/tvs_lending_backup.db"
#
# PostgreSQL Backup:
#   pg_dump -Fc tvs_lending > data/tvs_lending_$(date +%Y%m%d).dump
#
# PostgreSQL Restore:
#   pg_restore -d tvs_lending -c data/tvs_lending_YYYYMMDD.dump
