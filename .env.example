# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Google Gemini Live WebSockets (Native Bidirectional Audio & Grounded Tools)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-exp

# Optional Free Alternative LLM Providers for Text RAG
# GROQ_API_KEY=gsk_your_groq_key_here
# CEREBRAS_API_KEY=csk-your_cerebras_key_here
# OPENAI_API_KEY=sk-your_openai_key_here

# Local Offline Fallbacks
ENABLE_LOCAL_OLLAMA=false
OLLAMA_MODEL=qwen2.5:1.5b

# Institutional Security & Token Secret
TVS_AUTH_SECRET=tvs_epic8_super_secure_institutional_secret_2026
